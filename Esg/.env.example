# SMTP configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=alerts@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=alerts@example.com

# Comma-separated fallback recipients used when record fields do not contain email addresses.
ESG_REMINDER_EMAIL_RECIPIENTS=esg-team@example.com,compliance@example.com
INSURANCE_REMINDER_EMAIL_RECIPIENTS=insurance-team@example.com

# Optional logging level for the reminder command.
EXPIRY_REMINDER_LOG_LEVEL=INFO

# Cron example:
# 0 9 * * * /home/administrator/bp/bp-erp-backend/.venv/bin/python /home/administrator/bp/bp-erp-backend/Esg/manage.py check_expiry_reminders
